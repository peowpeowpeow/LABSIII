<%- include('partials/header') %>

<!-- Страница ошибки сервера с понятным описанием причины -->
<section class="error-page">
  <div class="error-page__code"><%= status %></div>
  <h1><%= status >= 500 ? 'Ошибка сервера' : 'Ошибка запроса' %></h1>
  <p class="error-page__message"><%= message %></p>

  <div class="card error-info">
    <h2>Что делать</h2>
    <p><%= hint %></p>
    <dl class="details">
      <dt>Код ошибки</dt><dd class="mono"><%= errorId %></dd>
      <dt>Время</dt><dd class="mono"><%= formatDateTime(occurredAt) %></dd>
      <dt>Запрос</dt><dd class="mono"><%= method %> <%= requestedUrl.slice(0, 120) %></dd>
    </dl>
    <p class="muted">По коду ошибки администратор найдёт подробности в журнале сервера.</p>
  </div>

  <div class="form__actions form__actions--center">
    <a class="btn btn--primary" href="<%= link('/') %>">На главную</a>
    <% if (method === 'GET') { %>
      <a class="btn btn--ghost" href="<%= link(requestedUrl.split('?')[0]) %>">Повторить запрос</a>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
